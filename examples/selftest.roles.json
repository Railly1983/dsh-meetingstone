{
  "version": 1,
  "roles": [
    {
      "roleId": "role-selftest",
      "name": "自检员",
      "aliases": [
        "SELFTEST"
      ],
      "description": "in-process spawn 通道自检",
      "channel": {
        "kind": "in-process",
        "provider": "spawn"
      },
      "permissionPreset": "project-write",
      "enabled": true,
      "timeoutMs": 120000
    },
    {
      "roleId": "role-selftest-fork",
      "name": "自检员B",
      "aliases": [
        "SELFTESTB"
      ],
      "description": "in-process fork 通道自检",
      "channel": {
        "kind": "in-process",
        "provider": "fork"
      },
      "permissionPreset": "project-write",
      "enabled": true,
      "timeoutMs": 120000
    },
    {
      "roleId": "role-selftest-ro",
      "name": "自检员只读",
      "aliases": [
        "SELFTESTRO"
      ],
      "description": "只读档位但未引用通道实例：验证 READONLY_UNENFORCEABLE 拒绝路径",
      "channel": {
        "kind": "in-process",
        "provider": "spawn"
      },
      "permissionPreset": "read-only",
      "enabled": true,
      "timeoutMs": 120000
    },
    {
      "roleId": "role-selftest-codex",
      "name": "自检员Codex",
      "aliases": [
        "SELFTESTCODEX"
      ],
      "description": "codex 通道自检",
      "channel": {
        "kind": "codex",
        "provider": "codex"
      },
      "permissionPreset": "project-write",
      "enabled": true,
      "timeoutMs": 300000
    },
    {
      "roleId": "role-selftest-codebuddy",
      "name": "自检员CodeBuddy",
      "aliases": [
        "SELFTESTCB"
      ],
      "description": "acp/CodeBuddy 通道自检",
      "channel": {
        "kind": "acp-cli",
        "provider": "acp"
      },
      "permissionPreset": "project-write",
      "enabled": true,
      "timeoutMs": 300000
    }
  ]
}
