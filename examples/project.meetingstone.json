{
  "version": 1,
  "defaultRoleId": "role-sashi",
  "roles": [
    {
      "roleId": "role-scout",
      "name": "斥候",
      "aliases": ["SC"],
      "description": "只读侦察：找文件、查依赖、读接口，不改代码",
      "channel": { "kind": "in-process", "channelId": "ch-inprocess" },
      "permissionPreset": "read-only",
      "enabled": true
    }
  ],
  "roleOverrides": {
    "role-sashi": {
      "permissionPreset": "read-only"
    }
  },
  "dispatchNotes": "这个仓库只改 src/，动 docs/ 前先问；禁止直接改 package.json。",
  "projectRules": [
    "未经确认不得修改数据库迁移文件",
    "同一项目的写任务默认串行"
  ],
  "limits": {
    "maxParallelReadonly": 2,
    "serializeWrites": true
  }
}
