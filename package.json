{
  "name": "dsh-meetingstone",
  "version": "0.1.0-alpha.25",
  "description": "A lightweight cross-CLI agent role and dispatch plugin for DeepSeek Harness.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "measure": "node scripts/measure-tool-output.mjs",
    "ledger": "node scripts/token-ledger.mjs",
    "check:host-schema": "node scripts/verify-host-schema.mjs",
    "check:manifest": "node scripts/verify-manifest.mjs",
    "check:package": "node scripts/verify-package.mjs",
    "release:check": "node scripts/release-check.mjs",
    "acceptance": "node scripts/acceptance-windows.mjs",
    "verify": "node scripts/run-tests.mjs && node scripts/verify-host-schema.mjs && node scripts/verify-manifest.mjs && node scripts/verify-package.mjs",
    "boot:canary": "node scripts/boot-canary.mjs",
    "install:safe": "node scripts/install-safe.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "agent",
    "cli",
    "dispatch",
    "role"
  ],
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-registry": "0.2.2-rc.1",
    "yaml": "^2.9.1",
    "zod": "4.4.3"
  },
  "license": "MIT"
}
