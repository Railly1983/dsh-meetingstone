{
  "version": 1,
  "roles": [
    {
      "roleId": "role-selftest",
      "name": "自检员",
      "aliases": ["SELFTEST"],
      "description": "进程内 spawn 通道的自检角色",
      "channel": {
        "kind": "in-process",
        "provider": "spawn"
      },
      "permissionPreset": "project-write",
      "enabled": true,
      "timeoutMs": 120000
    },
    {
      "roleId": "role-selftest-fork",
      "name": "自检员B",
      "aliases": ["SELFTESTB"],
      "description": "进程内 fork 通道的自检角色（对照实验）",
      "channel": {
        "kind": "in-process",
        "provider": "fork"
      },
      "permissionPreset": "project-write",
      "enabled": true,
      "timeoutMs": 120000
    }
  ],
  "dispatchNotes": "仓库自带项目级自检配置：用于验证「角色解析 → 通道 → 原生派单」整链，不写任何文件。",
  "limits": {
    "maxParallelReadonly": 2,
    "serializeWrites": true
  }
}
