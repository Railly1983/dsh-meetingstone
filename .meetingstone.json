{
  "version": 1,
  "roles": [
    {
      "roleId": "role-selftest",
      "name": "自检员",
      "aliases": [
        "SELFTEST"
      ],
      "description": "进程内 spawn 通道的自检角色",
      "channel": {
        "kind": "in-process",
        "provider": "spawn"
      },
      "permissionPreset": "project-write",
      "enabled": true,
      "timeoutMs": 120000
    },
    {
      "roleId": "role-selftest-fork",
      "name": "自检员B",
      "aliases": [
        "SELFTESTB"
      ],
      "description": "进程内 fork 通道的自检角色（对照实验）",
      "channel": {
        "kind": "in-process",
        "provider": "fork"
      },
      "permissionPreset": "project-write",
      "enabled": true,
      "timeoutMs": 120000
    },
    {
      "roleId": "role-selftest-ro",
      "name": "自检员只读",
      "aliases": [
        "SELFTESTRO"
      ],
      "description": "只读档位但不引用通道实例：用于验证 READONLY_UNENFORCEABLE 拒绝路径",
      "channel": {
        "kind": "in-process",
        "provider": "spawn"
      },
      "permissionPreset": "read-only",
      "enabled": true,
      "timeoutMs": 120000
    },
    {
      "roleId": "role-selftest-codex",
      "name": "自检员Codex",
      "aliases": [
        "SELFTESTCODEX"
      ],
      "description": "外部 CLI 通道自检：走官方 codex provider（需装 @deepseek-ai/dsh-subagent-codex）",
      "channel": {
        "kind": "codex",
        "provider": "codex"
      },
      "permissionPreset": "project-write",
      "enabled": true,
      "timeoutMs": 300000
    },
    {
      "roleId": "role-selftest-codebuddy",
      "name": "自检员CodeBuddy",
      "aliases": [
        "SELFTESTCB"
      ],
      "description": "外部 CLI 通道自检：走官方 acp provider + 本机 CodeBuddy ACP",
      "channel": {
        "kind": "acp-cli",
        "provider": "acp"
      },
      "permissionPreset": "project-write",
      "enabled": true,
      "timeoutMs": 300000
    },
    {
      "roleId": "role-tangtang",
      "name": "唐僧",
      "aliases": [
        "TT",
        "领导"
      ],
      "description": "团队领导：架构、关键决策、最终质量把关",
      "prompt": "你是团队领导，负责架构、战略、关键决策和最终质量把关。不要亲自做一线实现；给出方向、评审方案、验收结果，并对最终交付负责。额度有限，只在最重要的事情上动脑。",
      "channel": {
        "kind": "codex",
        "provider": "codex"
      },
      "permissionPreset": "project-write",
      "enabled": true,
      "timeoutMs": 3600000
    },
    {
      "roleId": "role-wukong",
      "name": "悟空",
      "aliases": [
        "WK",
        "专家"
      ],
      "description": "核心资深专家：疑难问题、审核验收、长时间任务",
      "prompt": "你是核心资深专家，负责解决疑难问题、审核验收和长时间 Agent 任务。优先给出可验证的结论和证据，不做表面修改；复核他人结论时必须自己动手验证，不得照抄。",
      "channel": {
        "kind": "codex",
        "provider": "codex"
      },
      "permissionPreset": "project-write",
      "enabled": true,
      "timeoutMs": 3600000
    },
    {
      "roleId": "role-sashi",
      "name": "沙僧",
      "aliases": [
        "SS",
        "主力执行"
      ],
      "description": "技术骨干：主力开发、常规实现、批量执行",
      "prompt": "你是技术骨干，负责主力开发、常规实现和批量执行。按任务要求执行，只改被授权的文件；每个结论都要附证据，拿不到就写未验证，不要猜。",
      "channel": {
        "kind": "acp-cli",
        "provider": "acp"
      },
      "permissionPreset": "project-write",
      "enabled": true,
      "timeoutMs": 3600000
    },
    {
      "roleId": "role-xiaobai",
      "name": "小白",
      "aliases": [
        "XB",
        "打杂"
      ],
      "description": "牛马：主力开发、文档、测试辅助",
      "prompt": "你是小白，负责主力开发、文档整理、测试辅助和各类杂活。按任务要求执行，只改被授权的文件；不确定的先说明，不要编造。",
      "channel": {
        "kind": "acp-cli",
        "provider": "acp"
      },
      "permissionPreset": "project-write",
      "enabled": true,
      "timeoutMs": 3600000
    }
  ],
  "dispatchNotes": "常规实现优先沙僧/小白；关键修改交悟空复核；重大取舍才找唐僧。",
  "limits": {
    "maxParallelReadonly": 2,
    "serializeWrites": true
  }
}
